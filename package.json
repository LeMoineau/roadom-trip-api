{
  "name": "roadom-trip-api",
  "version": "1.0.0",
  "description": "roadom-trip api",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node ./dist/src/index.js",
    "start:dev": "dotenv -e .env.development -- node ./dist/src/index.js",
    "start:prod": "dotenv -e .env.production -- node ./dist/src/index.js",
    "update:shared": "rimraf ./src/shared && copyfiles -u 3 ./../shared/src/**/* ./src/shared/",
    "build": "rimraf ./dist && tsc",
    "dev": "dotenv -e .env.development -- tsx watch src/index.ts",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "author": "Pierrot",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/osrm": "^5.25.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@geo-maps/earth-seas-10m": "^0.6.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@prisma/client": "^5.11.0",
    "@types/body-parser": "^1.19.5",
    "axios": "^1.13.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.1",
    "express": "^4.18.2",
    "fs": "^0.0.1-security",
    "geojson-geometries-lookup": "^0.5.0",
    "geolib": "^3.3.4",
    "moment": "^2.30.1",
    "node-html-parser": "^7.1.0",
    "path": "^0.12.7",
    "prisma": "^5.11.0",
    "rebus-fr": "^1.3.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
